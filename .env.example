# ============================================================================
# MOEX Trading Bot - пример файла окружения.
# Скопируйте: cp .env.example .env  и заполните реальными значениями.
# Файл .env НИКОГДА не коммитится в git и не попадает в публичные места.
# ============================================================================

# --- Т-Инвестиции (T-Invest API) -------------------------------------------
# Токен для ПЕСОЧНИЦЫ: https://www.tbank.ru/invest/ -> Профиль -> Настройки ->
# "Токен для песочницы" (нужен доступ к API).
TINKOFF_SANDBOX_TOKEN=t.example_sandbox_token

# Токен для РЕАЛЬНОГО счёта (выпускается там же). Можно оставить пустым,
# пока не готовы к реальной торговле - бот не даст включить реальный режим
# без этого токена.
TINKOFF_TOKEN=

# --- Groq (бесплатный ИИ) ---------------------------------------------------
# Ключ: https://console.groq.com/keys (регистрация по email, без карты).
GROQ_API_KEY=gsk_example_key
# Модель Groq. Бесплатные варианты: llama-3.1-8b-instant (быстрая, 30 RPM)
# или openai/gpt-oss-20b (умнее, чуть медленнее). llama3-8b-8192 выведена
# из эксплуатации Groq.
GROQ_MODEL=openai/gpt-oss-20b

# --- Telegram ---------------------------------------------------------------
# Токен бота: напишите @BotFather -> /newbot.
TELEGRAM_BOT_TOKEN=1234567890:AAExample
# Ваш числовой ID (узнать: @userinfobot). Команды принимает ТОЛЬКО этот ID.
TELEGRAM_ADMIN_ID=123456789
# Если api.telegram.org недоступен с VPS (блокировка хостера) - укажите здесь
# адрес реверс-прокси (например, Cloudflare Worker). Пусто = официальный API.
TELEGRAM_API_BASE=

# --- Режим работы -----------------------------------------------------------
# Стартовый режим. True = песочница (НАСТОЯТЕЛЬНО рекомендуется первые недели).
# После первого запуска режим сохраняется в state.json и переключается
# командой /toggle_sandbox из Telegram (с подтверждением).
USE_SANDBOX=True
# Торговля по умолчанию выключена - включается командой /toggle_trading.
TRADING_ENABLED=False
# Локальный аудит логов включён. По умолчанию он работает без Groq.
AUDITOR_ENABLED=True
# Включать Groq-аудит только вручную/осознанно: это дополнительный расход TPD.
AUDITOR_LLM_ENABLED=False

# --- Торговая стратегия -----------------------------------------------------
# Тикеры через запятую, максимум 6 (v1.6.0). Можно не трогать и добавлять
# бумаги на ходу командой /watch (список сохраняется в state.json).
# Пример: SBER,GAZP,LKOH,GMKN,ROSN,MTSS
TRADING_TICKERS=SBER,GAZP,LKOH,GMKN,ROSN,MTSS
# Период скользящей средней на ЧАСОВЫХ свечах (CANDLE_INTERVAL_HOUR).
SMA_PERIOD=24
# Интервал опроса рынка, секунд (300 = 5 минут: 6 тикеров * ~4 запроса +
# проход сканера раз в 10 мин - запас по лимитам большой).
POLL_INTERVAL_SEC=300
# Максимальный размер позиции, % от свободных средств.
MAX_POSITION_PCT=10
# Стоп-лосс, % ниже цены входа.
STOP_LOSS_PCT=3
# Тейк-профит, % выше цены входа. Рекомендуется 8-10, чтобы умная фиксация
# прибыли (HARVEST_TIERS ниже) успевала защищать большие росты.
TAKE_PROFIT_PCT=8
# Порог сентимента: покупаем только если тональность новостей ВЫШЕ порога.
SENTIMENT_THRESHOLD=-0.3

# --- Частота торговли и страховки -------------------------------------------
# Пауза между покупками одной бумаги, минут (сокращается агрессивностью).
TRADE_COOLDOWN_MIN=120
# Потолок покупок в сутки по всем тикерам (движок считает свой лимит,
# но выше этого значения не прыгнет).
MAX_BUYS_PER_DAY=12

# --- Обучение на ошибках (память сделок) -------------------------------------
# Учитывать итоги прошлых сделок: паузы, повышенные пороги, плохие часы.
LEARNING=True
# Сколько закрытых сделок хранить в data/trade_memory.json.
MEMORY_MAX_TRADES=400
# Дневной лимит убытка, % от капитала: после него новых покупок до завтра.
DAILY_LOSS_LIMIT_PCT=1.5
# Комиссия песочницы T-Invest: 0,05% за каждое ИСПОЛНЕННОЕ поручение.
# Круг покупка+продажа = 0,10%. К ней код добавляет фактический спред и
# проскальзывание (см. SLIPPAGE_PCT) - полные издержки участвуют в проверках
# «цель покрывает издержки» и в расчёте безубыточной вероятности.
ESTIMATED_ROUND_TRIP_COST_PCT=0.10
# Оценка проскальзывания за круг, % от номинала (v1.9.0). Для топ-ликвидности
# хватает 0.05%; для малоликвидных бумаг поднимите до 0.1-0.2.
SLIPPAGE_PCT=0.05
# Пауза бумаге после 3 убытков подряд, часов.
LOSS_STREAK_PAUSE_H=4.0

# --- Лестница выходов --------------------------------------------------------
# Устаревшие параметры совместимости: стоп теперь жёсткий и не зависит от ИИ.
SL_CONFIRM_CYCLES=1
SL_VETO_CONFIDENCE=1.0
# Legacy-параметр, оставлен для совместимости: в v1.8.1 не влияет на стоп.
HARD_SL_MULT=1.5
# Трейлинг-стоп: включается с прибыли +2%, продаёт при откате 1.5%.
TRAILING_ACTIVATE_PCT=2.0
TRAILING_DROP_PCT=1.5
# УМНАЯ ФИКСАЦИЯ ПРИБЫЛИ (v1.6.0): пары "пик_%:допустимый_откат_в_пунктах".
# Чем выше был пик прибыли, тем меньший откат терпим - при сильном росте
# продаём уже при крошечном падении. Пример: пик +8.4% -> продажа при падении
# на 0.25 п.п. от пика. Пусто = выключена.
HARVEST_TIERS=3.0:0.7,5.0:0.4,8.0:0.25
# Досрочная продажа по вердикту ИИ только в плюс не меньше этого %.
LLM_EARLY_SELL_MIN_PROFIT=0.5

# --- Умные предохранители входа (v1.7.0) -------------------------------------
# АНТИ-ПОГОНЯ: не покупать, если цена в пределах CHASE_GUARD_PCT % от локального
# хая последних 30 минут, пока не отскочит вниз на CHASE_BOUNCE_PCT %.
CHASE_GUARD_PCT=0.5
CHASE_BOUNCE_PCT=1.2
# РАДАР РАЗВОРОТА: если бумага выросла на SURGE_SENSE_FROM_PCT % и начала
# падать - сигнал продавать при первом намёке на разворот (в скальпе 1.5).
SURGE_SENSE_FROM_PCT=3.0
# УТРЕННИЙ ЯКОРЬ: до этого часа (МСК) опираемся на вчерашнюю основную сессию.
MORNING_ANCHOR_UNTIL=13

# --- Скальп-режим (v1.8.1, вкл/выкл командой /scalp) -------------------------
# Настройки применяются только когда скальп-режим включён в Telegram.
# Максимум одновременно открытых скальп-позиций (жёсткий предел 8).
SCALP_MAX_POSITIONS=8
# Период полных циклов (вход+выход), секунд.
SCALP_POLL_SEC=300
# Период быстрых циклов только выхода, секунд.
SCALP_EXIT_POLL_SEC=60
# Пауза между сделками одной бумаги в скальпе, минут.
SCALP_COOLDOWN_MIN=20
# Устаревшие совместимые параметры; актуальный стоп считается как clamp(1.2×ATR, 0.6%, 1.0%), TP1=1R, TP2=2R.
SCALP_STOP_LOSS_PCT=1.0
SCALP_TAKE_PROFIT_PCT=2.0
# Совместимые legacy-настройки: скальп использует TP1/2R и ATR-трейлинг после TP1.
SCALP_TRAILING_ACTIVATE=1.0
SCALP_TRAILING_DROP=0.5
# Legacy-порог; в новом скальп-выходе используются ATR, TP1/2R и time-stop.
SCALP_SURGE_FROM_PCT=1.5
# Параметры риск-менеджмента скальпа (правила выполняет код, не LLM).
# До 40 входов в день: после закрытия позиции слот снова доступен.
SCALP_MAX_ENTRIES_PER_DAY=40
# Плановый риск на один вход; 8 позиций суммарно ограничены 0.40% equity.
SCALP_RISK_PER_TRADE_PCT=0.05
SCALP_MAX_PORTFOLIO_RISK_PCT=0.40
SCALP_DAILY_LOSS_LIMIT_PCT=1.0
SCALP_MAX_POSITION_PCT=15
SCALP_MIN_STOP_PCT=0.6
SCALP_ATR_MULTIPLIER=1.2
SCALP_MAX_STOP_PCT=1.0
SCALP_MAX_SPREAD_PCT=0.1
SCALP_ROUND_TRIP_COST_PCT=0.1
# v1.9.0: цель (TP1=1R) должна быть минимум в 4 раза больше круговых издержек
# (комиссия+спред+проскальзывание) - трение не съедает больше ~25% цели.
SCALP_MIN_REWARD_COST_MULTIPLE=4.0
SCALP_TIME_STOP_MIN=45
SCALP_MIN_PROGRESS_R=0.3
SCALP_LOSS_PAUSE_MIN=60
SCALP_STOP_COOLDOWN_MIN=120
SCALP_MAX_SECTOR_POSITIONS=2

# --- Сканер рынка (v1.6.0) ---------------------------------------------------
# Фоновый поиск кандидатов на покупку по всему ликвидному рынку TQBR.
SCAN_ENABLED=True
# Период сканирования, минут (владелец просил 10; минимум 5).
SCAN_INTERVAL_MIN=10
# Мин. суточный оборот бумаги, млн руб (отсекает неликвид; 50 - "почти весь" рынок).
SCAN_MIN_TURNOVER_MLN=50
# Мин. цена бумаги, руб (отсекает копеечные).
SCAN_MIN_PRICE=5
# Сколько бумаг из пула глубоко считать по свечам за проход (5-60).
SCAN_DEEP_N=20
# Сколько кандидатов присылать в отчёте (3-10). 6 = 2 фото по 3 графика.
SCAN_REPORT_TOP=6
# Один компактный пакетный запрос Groq только по 1-3 лучшим кандидатам за скан.
SCAN_LLM=True
SCAN_AI_CANDIDATES=3
SCAN_MIN_CANDIDATE_RANK=48
AI_BATCH_DECISION_TTL_SEC=900
AI_MIN_REQUEST_INTERVAL_SEC=600
AI_BATCH_REQUIRED=True
# Локальный дневной бюджет 120k из 200k TPD: резерв 80k для возможных
# других запросов в той же организации Groq. Счётчик сохраняется в data/.
GROQ_DAILY_TOKEN_BUDGET=120000

# --- Автопокупка кандидатов сканера (v1.7.1) ---------------------------------
# Бот САМ покупает лучших кандидатов сканера (сигнал + ИИ сошлись), а не
# только предлагает кнопки. Переключается в Telegram командой /autobuy.
# Покупки идут через обычный путь движка: лимиты позиций, анти-погоня,
# cooldown, лимиты торгов - всё соблюдается. Только основная сессия.
SCAN_AUTO_BUY=True
# Максимум автопокупок за один скан: 2; дополнительно действуют лимиты риска.
SCAN_AUTO_BUY_PER_SCAN=2

# --- ИИ-аудитор и лимиты ----------------------------------------------------
# ИИ используется только для пакетного финального выбора top-3 из математического
# shortlist. Сетап, спред, ATR, лимиты и выходы проверяются локальным кодом.
LLM_DECISIONS=True
# Интервал проверки логов ИИ-аудитором, секунд (3600 = каждый час).
AUDIT_INTERVAL_SEC=3600
# Сколько последних строк лога отправлять аудитору.
AUDIT_LOG_LINES=50
# Локальный ограничитель частоты запросов к T-Invest API (в минуту).
# Официальные лимиты: 100-300 запросов/мин на метод; 90 - с большим запасом.
RATE_LIMIT_RPM=90

# --- Новости (бесплатные RSS, без ключей) -----------------------------------
# Ленты, из которых бот собирает новости по тикерам (поиск по названию).
# ВНИМАНИЕ: RSS-экспорт RBC (rssexport.rbc.ru) закрыт и отдаёт HTTP 404 -
# не добавляйте его, иначе в логе будет warning при каждом цикле.
NEWS_RSS_URLS=https://www.interfax.ru/rss.asp
# Сколько секунд действует кэш сентимента по тикеру (экономия лимитов Groq).
SENTIMENT_TTL_SEC=21600

# --- Прочее -----------------------------------------------------------------
# Стартовый баланс песочницы (зачисляется один раз при создании счёта).
SANDBOX_START_BALANCE=100000
# Очистка: удалять ротированные логи старше N дней и держать папку логов < N МБ.
CLEANUP_KEEP_DAYS=14
CLEANUP_MAX_LOGS_MB=20
# Уровень логирования: DEBUG / INFO / WARNING.
LOG_LEVEL=INFO
