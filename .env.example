# ============================================================================
# MOEX Trading Bot - пример файла окружения.
# Скопируйте: cp .env.example .env  и заполните реальными значениями.
# Файл .env НИКОГДА не коммитится в git и не попадает в публичные места.
# ============================================================================

# --- Т-Инвестиции (T-Invest API) -------------------------------------------
# Токен для ПЕСОЧНИЦЫ: https://www.tbank.ru/invest/ -> Профиль -> Настройки ->
# "Токен для песочницы" (нужен доступ к API).
TINKOFF_SANDBOX_TOKEN=t.example_sandbox_token

# Токен для РЕАЛЬНОГО счёта (выпускается там же). Можно оставить пустым,
# пока не готовы к реальной торговле - бот не даст включить реальный режим
# без этого токена.
TINKOFF_TOKEN=

# --- Groq (бесплатный ИИ) ---------------------------------------------------
# Ключ: https://console.groq.com/keys (регистрация по email, без карты).
GROQ_API_KEY=gsk_example_key
# Модель Groq. Бесплатные варианты: llama-3.1-8b-instant (быстрая, 30 RPM)
# или openai/gpt-oss-20b (умнее, чуть медленнее). llama3-8b-8192 выведена
# из эксплуатации Groq.
GROQ_MODEL=openai/gpt-oss-20b

# --- Telegram ---------------------------------------------------------------
# Токен бота: напишите @BotFather -> /newbot.
TELEGRAM_BOT_TOKEN=1234567890:AAExample
# Ваш числовой ID (узнать: @userinfobot). Команды принимает ТОЛЬКО этот ID.
TELEGRAM_ADMIN_ID=123456789
# Если api.telegram.org недоступен с VPS (блокировка хостера) - укажите здесь
# адрес реверс-прокси (например, Cloudflare Worker). Пусто = официальный API.
TELEGRAM_API_BASE=

# --- Режим работы -----------------------------------------------------------
# Стартовый режим. True = песочница (НАСТОЯТЕЛЬНО рекомендуется первые недели).
# После первого запуска режим сохраняется в state.json и переключается
# командой /toggle_sandbox из Telegram (с подтверждением).
USE_SANDBOX=True
# Торговля по умолчанию выключена - включается командой /toggle_trading.
TRADING_ENABLED=False
# ИИ-аудитор логов включён по умолчанию (каждый AUDIT_INTERVAL_SEC).
AUDITOR_ENABLED=True

# --- Торговая стратегия -----------------------------------------------------
# Тикеры через запятую, максимум 5 (требование по памяти и лимитам API).
# Пример: SBER,GAZP,LKOH,YDEX,MTSS
TRADING_TICKERS=SBER,GAZP,LKOH
# Период скользящей средней на ЧАСОВЫХ свечах (CANDLE_INTERVAL_HOUR).
SMA_PERIOD=24
# Интервал опроса рынка, секунд (300 = 5 минут: 5 тикеров * ~4 запроса = 2400
# запросов/сутки при лимите 300/мин по каждому методу - огромный запас).
POLL_INTERVAL_SEC=300
# Максимальный размер позиции, % от свободных средств.
MAX_POSITION_PCT=10
# Стоп-лосс, % ниже цены входа.
STOP_LOSS_PCT=3
# Тейк-профит, % выше цены входа.
TAKE_PROFIT_PCT=5
# Порог сентимента: покупаем только если тональность новостей ВЫШЕ порога.
SENTIMENT_THRESHOLD=-0.3

# --- Частота торговли и страховки -------------------------------------------
# Пауза между покупками одной бумаги, минут (сокращается агрессивностью).
TRADE_COOLDOWN_MIN=120
# Потолок покупок в сутки по всем тикерам (движок считает свой лимит,
# но выше этого значения не прыгнет).
MAX_BUYS_PER_DAY=25

# --- Обучение на ошибках (память сделок) -------------------------------------
# Учитывать итоги прошлых сделок: паузы, повышенные пороги, плохие часы.
LEARNING=True
# Сколько закрытых сделок хранить в data/trade_memory.json.
MEMORY_MAX_TRADES=400
# Дневной лимит убытка, % от капитала: после него новых покупок до завтра.
DAILY_LOSS_LIMIT_PCT=2.0
# Пауза бумаге после 3 убытков подряд, часов.
LOSS_STREAK_PAUSE_H=4.0

# --- Лестница выходов --------------------------------------------------------
# Циклов ниже стоп-лосса до продажи (за каждый цикл бот спрашивает ИИ).
SL_CONFIRM_CYCLES=2
# Уверенность ИИ, чтобы ОДИН раз отложить стоп-лосс (0.6 = 60%).
SL_VETO_CONFIDENCE=0.60
# Аварийный стоп = стоп-лосс * этот множитель (продаётся мгновенно).
HARD_SL_MULT=1.5
# Трейлинг-стоп: включается с прибыли +2%, продаёт при откате 1.5%.
TRAILING_ACTIVATE_PCT=2.0
TRAILING_DROP_PCT=1.5
# Досрочная продажа по вердикту ИИ только в плюс не меньше этого %.
LLM_EARLY_SELL_MIN_PROFIT=0.5

# --- ИИ-аудитор и лимиты ----------------------------------------------------
# Скилл "трейдер-LLM" (AI даёт вердикт buy/sell/hold перед каждой сделкой).
# False = старое чисто индикаторное правило (цена ниже средней + не плохие
# новости). По умолчанию включён.
LLM_DECISIONS=True
# Интервал проверки логов ИИ-аудитором, секунд (3600 = каждый час).
AUDIT_INTERVAL_SEC=3600
# Сколько последних строк лога отправлять аудитору.
AUDIT_LOG_LINES=50
# Локальный ограничитель частоты запросов к T-Invest API (в минуту).
# Официальные лимиты: 100-300 запросов/мин на метод; 90 - с большим запасом.
RATE_LIMIT_RPM=90

# --- Новости (бесплатные RSS, без ключей) -----------------------------------
# Ленты, из которых бот собирает новости по тикерам (поиск по названию).
NEWS_RSS_URLS=https://www.interfax.ru/rss.asp,https://rssexport.rbc.ru/rbcnews/news/30/full
# Сколько секунд действует кэш сентимента по тикеру (экономия лимитов Groq).
SENTIMENT_TTL_SEC=21600

# --- Прочее -----------------------------------------------------------------
# Стартовый баланс песочницы (зачисляется один раз при создании счёта).
SANDBOX_START_BALANCE=100000
# Очистка: удалять ротированные логи старше N дней и держать папку логов < N МБ.
CLEANUP_KEEP_DAYS=14
CLEANUP_MAX_LOGS_MB=20
# Уровень логирования: DEBUG / INFO / WARNING.
LOG_LEVEL=INFO
